# Chép file này thành .env (đã có trong .gitignore) rồi điền giá trị. Không commit khóa thật.

# openai: tạo biên bản bằng OpenAI. none: tắt AI (chế độ Offline), vẫn sửa và xuất biên bản tay được.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max
LLM_REASONING_EFFORT=medium
OPENAI_API_KEY=

# Thư mục chứa voxscribe.db. Để trống: %LOCALAPPDATA%\VoxScribe
VOXSCRIBE_DATA_DIR=
